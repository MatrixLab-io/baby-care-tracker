rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /babies/{babyId} {
      // Only authenticated users can access their own babies
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow create if the userId field matches the authenticated user
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Medical records subcollection inherits parent baby access
      match /medicalRecords/{recordId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/babies/$(babyId)).data.userId == request.auth.uid;
      }
    }
  }
}
